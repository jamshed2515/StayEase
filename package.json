{
  "name": "stayease-hotel-booking",
  "version": "1.0.0",
  "description": "StayEase - Premium Hotel Booking Management System (MERN)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan.bold,yellow.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start:server": "npm --prefix server start",
    "build:client": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm install && npm run install:server && npm run install:client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
